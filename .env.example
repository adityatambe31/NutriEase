# Copy to .env.local (never commit credentials). Rotate all keys from original sample.env first.
AUTH_SECRET=replace-with-new-random-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
MONGODB_URI=
# Safe by default: no external paid API call unless explicitly enabled.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_API_KEY_COOK=
GEMINI_MODEL=gemini-2.5-flash
# Optional; image fetches disabled by default.
IMAGES_ENABLED=false
PEXELS_API_KEY=
# Explicit server-side daily quota per signed-in user; hard coded max is 3.
AI_DAILY_LIMIT=2
NEXT_PUBLIC_ENVIRONMENT=dev



